# Frimin Optional Environment Configuration
# Zero API keys are required for default live operation.
# Out of the box, Frimin queries public Coinbase, Kraken, Hyperliquid, DexScreener,
# Ethereum Mainnet JSON-RPC, Solana Mainnet RPC, Telegram Web, and RSS endpoints.

# Optional custom RPC endpoints (defaults to public Mainnet RPCs if omitted)
ETH_RPC_URL=
SOLANA_RPC_URL=

# Optional read-only social stream credentials (can also be configured in the Rules tab)
X_BEARER_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
